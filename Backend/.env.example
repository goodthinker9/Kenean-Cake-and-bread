APP_NAME="Golden Crust"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Supabase PostgreSQL — Session Pooler connection (SSL required)
#
# 1. Go to Supabase Dashboard → your project → Settings → Database
# 2. Under "Connection pooling", choose "Session mode" (port 5432)
# 3. Copy the individual fields below from the connection string shown.
#
# Example connection string shown in the dashboard:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# DB_HOST   = the host part  (e.g. aws-0-eu-central-1.pooler.supabase.com)
# DB_USERNAME = postgres.[project-ref]  (note the dot — this is important)
# DB_PASSWORD = the database password you set when creating the project
# ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=YOUR_POOLER_HOST.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require
DB_SEARCH_PATH=public

# ---------------------------------------------------------------
# If you see SSL errors on Windows, add this to php.ini:
#   pgsql.allow_persistent = On
#   pgsql.auto_reset_persistent = Off
# And make sure openssl.cafile points to a valid CA bundle, e.g.:
#   openssl.cafile = "C:/php/extras/ssl/cacert.pem"
# Download cacert.pem from: https://curl.se/ca/cacert.pem
# ---------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
